<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Límite de apps</string>
    <string name="accessibility_description">Detecta cuándo pasa a primer plano una app que has limitado y la cierra cuando se agota el tiempo de hoy. Solo vigila las apps que limitas y no lee el contenido de la pantalla.</string>

    <string name="setup_title">Configuración</string>
    <string name="setup_intro">Dos permisos y listo. Nada sale del móvil: esta app no tiene acceso a internet.</string>
    <string name="setup_accessibility_title">Accesibilidad</string>
    <string name="setup_accessibility_text">Permite saber qué app está delante y cerrarla cuando se agota su tiempo. Solo atiende a las apps que limites.</string>
    <string name="setup_accessibility_button">Abrir ajustes de accesibilidad</string>
    <string name="setup_restricted_text">¿El interruptor sale gris o aparece \"ajuste restringido\"? Abre Info de la app, toca el menú ⋮, elige \"Permitir ajustes restringidos\" y vuelve a intentarlo.</string>
    <string name="setup_restricted_button">Abrir info de la app</string>
    <string name="setup_usage_title">Acceso a datos de uso</string>
    <string name="setup_usage_text">Muestra cuánto has usado hoy cada app. Solo lee el historial que Android ya guarda y no gasta batería.</string>
    <string name="setup_usage_button">Abrir acceso a datos de uso</string>
    <string name="setup_done">Hecho</string>

